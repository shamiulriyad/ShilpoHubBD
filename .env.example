# Frontend
VITE_API_BASE_URL=http://localhost:5065/api

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5065
# From Supabase dashboard -> Project Settings -> Database -> Connection string (URI or session pooler).
ConnectionStrings__DefaultConnection=Host=YOUR_DATABASE_HOST;Port=5432;Database=postgres;Username=YOUR_DATABASE_USER;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require
Jwt__Issuer=ShilpoHubBD
Jwt__Audience=ShilpoHubBD.Users
Jwt__Key=replace-with-a-long-random-secret-key
Supabase__Url=https://your-project.supabase.co
Supabase__AnonKey=your-anon-key
Supabase__ServiceRoleKey=your-service-role-key
Supabase__StorageBucket=uploads
Seed__SuperAdminEmail=
Seed__SuperAdminPassword=